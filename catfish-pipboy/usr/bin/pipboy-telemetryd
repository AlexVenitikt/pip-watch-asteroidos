#!/bin/sh
set -eu

OUT="/tmp/pipboy-telemetry.json"
TMP="${OUT}.tmp"
QML_OUT="/tmp/pipboy-telemetry.qml"
QML_TMP="${QML_OUT}.tmp"
SESSION_ID=424242
HR_SERVICE="com.nokia.SensorService"
HR_PATH="/SensorManager/hrmsensor"
HR_IFACE="local.HrmSensor"

cleanup() {
    busctl --system call "$HR_SERVICE" "$HR_PATH" "$HR_IFACE" stop i "$SESSION_ID" >/dev/null 2>&1 || true
}

trap cleanup EXIT INT TERM

busctl --system call "$HR_SERVICE" "$HR_PATH" "$HR_IFACE" start i "$SESSION_ID" >/dev/null 2>&1 || true

while true; do
    HEART_RATE="$(busctl --system get-property "$HR_SERVICE" "$HR_PATH" "$HR_IFACE" heartRate 2>/dev/null | awk '{print $NF}')"

    case "$HEART_RATE" in
        ''|*[!0-9]*)
            HEART_RATE=-1
            ;;
    esac

    if [ "$HEART_RATE" -le 0 ] || [ "$HEART_RATE" -ge 260 ]; then
        HEART_RATE=-1
    fi

    UPDATED_AT="$(date +%s)"
    printf '{"heartRate":%s,"steps":-1,"updatedAt":%s}\n' "$HEART_RATE" "$UPDATED_AT" > "$TMP"
    mv "$TMP" "$OUT"
    {
        printf 'import QtQml 2.0\n'
        printf 'QtObject {\n'
        printf '    property int heartRate: %s\n' "$HEART_RATE"
        printf '    property int steps: -1\n'
        printf '    property int updatedAt: %s\n' "$UPDATED_AT"
        printf '}\n'
    } > "$QML_TMP"
    mv "$QML_TMP" "$QML_OUT"
    sleep 5
done
